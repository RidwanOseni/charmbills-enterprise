/docs/
!/docs/README.md

# === KEEP THESE FILES (DO NOT IGNORE) ===
# WASM files - Required for trustless infrastructure
!**/*.wasm
!charmbills-backend/src/charms/wasm/*.wasm
!charmbills-frontend/public/*.wasm
!charmbills-frontend/lib/wasm/*.wasm

# Type definitions - Required for TypeScript
!**/*.d.ts
!charmbills-backend/src/charms/wasm/*.d.ts
!charmbills-frontend/lib/wasm/*.d.ts

# JSON config files - Keep all except specific lock files
!*.json
!package.json
!tsconfig.json
!components.json
!**/tsconfig.json
!**/package.json
# But ignore these specific JSON files
package-lock.json
yarn.lock
pnpm-lock.yamlrun_test.sh
generate-hex.ts
anchor_hex.txt
debug/
*.log
transactions/*.json
run_test.sh
